{
	"schemaVersion": 1,
	"id": "echoesofantiquity",
	"version": "${version}",
	"name": "Echoes of Antiquity",
	"description": "This mod is based on Game Theory's videos about the Minecraft Lore. It will always be WIP",
	"authors": [
		"FROSTYTRIX"
	],
	"contact": {
		"homepage": "https://github.com/FROSTYTRIX",
		"sources": "https://github.com/FROSTYTRIX/echoes-of-antiquity"
	},
	"license": "MIT",
	"icon": "assets/echoesofantiquity/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.frostytrix.echoesofantiquity.EchoesOfAntiquity"
		],
		"fabric-datagen": [
			"net.frostytrix.echoesofantiquity.EchoesOfAntiquityDataGenerator"
		],
		"client": [
			"net.frostytrix.echoesofantiquity.EchoesOfAntiquityClient"
		],
		"emi": [
			"net.frostytrix.echoesofantiquity.compat.emi.EchoesEmiPlugin"
		]
	},
	"mixins": [
		"echoesofantiquity.mixins.json",
		{
			"config": "echoesofantiquity.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"patchouli": "*",
		"emi": "*"
	}
}